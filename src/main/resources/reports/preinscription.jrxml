<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="preinscription"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <!-- ================= PARAMETERS ================= -->

    <!-- 🔥 CORRIGÉ -->
    <parameter name="LOGO" class="java.io.InputStream"/>
    <parameter name="SIGNATURE" class="java.io.InputStream"/>

    <parameter name="NUMERO_DEMANDE" class="java.lang.String"/>
    <parameter name="ANNEE_UNIV" class="java.lang.String"/>
    <parameter name="CIVILITE" class="java.lang.String"/>
    <parameter name="NOM" class="java.lang.String"/>
    <parameter name="PRENOM" class="java.lang.String"/>
    <parameter name="DATE_NAISSANCE" class="java.lang.String"/>
    <parameter name="LIEU_NAISSANCE" class="java.lang.String"/>
    <parameter name="NATIONALITE" class="java.lang.String"/>
    <parameter name="EMAIL" class="java.lang.String"/>
    <parameter name="TELEPHONE" class="java.lang.String"/>
    <parameter name="WHATSAPP" class="java.lang.String"/>
    <parameter name="NIVEAU" class="java.lang.String"/>
    <parameter name="FORMATION_TITRE" class="java.lang.String"/>
    <parameter name="SPECIALITE" class="java.lang.String"/>
    <parameter name="EMETTEUR_NOM" class="java.lang.String"/>
    <parameter name="EMETTEUR_FONCTION" class="java.lang.String"/>
    <parameter name="DATE_EMISSION" class="java.lang.String"/>

    <queryString><![CDATA[]]></queryString>

    <title>
        <band height="622">

            <!-- ================= LOGO ================= -->
            <image>
                <reportElement x="0" y="3" width="130" height="46"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>

            <!-- ================= HEADER ================= -->
            <staticText>
                <reportElement x="285" y="10" width="270" height="19"/>
                <text><![CDATA[ECOLE SUPERIEURE PRIVEE RECONNUE PAR L’ETAT]]></text>
            </staticText>

            <staticText>
                <reportElement x="300" y="30" width="230" height="16"/>
                <text><![CDATA[Décrets N°071/PR/MESRSIT & 072/PR/MESRSIT]]></text>
            </staticText>

            <rectangle>
                <reportElement x="22" y="55" width="515" height="2" backcolor="#00AEEF"/>
            </rectangle>

            <!-- ================= ANNEE ================= -->
            <textField>
                <reportElement x="0" y="62" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Année universitaire : " + $P{ANNEE_UNIV}]]></textFieldExpression>
            </textField>

            <!-- ================= TITLE ================= -->
            <rectangle>
                <reportElement x="22" y="91" width="515" height="36"/>
            </rectangle>

            <textField>
                <reportElement x="120" y="94" width="330" height="30"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["ATTESTATION DE PREINSCRIPTION N°" + $P{NUMERO_DEMANDE}]]></textFieldExpression>
            </textField>

            <!-- ================= INFOS ================= -->
            <textField>
                <reportElement x="0" y="145" width="554" height="19"/>
                <textFieldExpression><![CDATA[
                    "Je soussigné(e), " + $P{EMETTEUR_NOM} + ", " + $P{EMETTEUR_FONCTION} + ", atteste que :"
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="166" width="515" height="19"/>
                <textFieldExpression><![CDATA[
                    "M./Mme/Mlle : " + $P{CIVILITE} + " " + $P{NOM} + " " + $P{PRENOM}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="187" width="515" height="19"/>
                <textFieldExpression><![CDATA[
                    "Né(e) le : " + $P{DATE_NAISSANCE} + " à " + $P{LIEU_NAISSANCE}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="208" width="515" height="19"/>
                <textFieldExpression><![CDATA["Nationalité : " + $P{NATIONALITE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="229" width="515" height="19"/>
                <textFieldExpression><![CDATA["Adresse email : " + $P{EMAIL}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="250" width="515" height="19"/>
                <textFieldExpression><![CDATA["Téléphone : " + $P{TELEPHONE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="271" width="515" height="19"/>
                <textFieldExpression><![CDATA["WhatsApp : " + $P{WHATSAPP}]]></textFieldExpression>
            </textField>

            <!-- ================= FORMATION ================= -->
            <textField>
                <reportElement x="0" y="299" width="515" height="19"/>
                <textFieldExpression><![CDATA[
                    "Est préinscrit(e) pour l'année universitaire " + $P{ANNEE_UNIV}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="10" y="321" width="500" height="19"/>
                <textFieldExpression><![CDATA["√ " + $P{NIVEAU}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="10" y="343" width="500" height="19"/>
                <textFieldExpression><![CDATA["√ " + $P{FORMATION_TITRE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="10" y="365" width="500" height="19"/>
                <textFieldExpression><![CDATA["√ Spécialité : " + $P{SPECIALITE}]]></textFieldExpression>
            </textField>

            <!-- ================= DATE ================= -->
            <textField>
                <reportElement x="281" y="413" width="200" height="19"/>
                <textFieldExpression><![CDATA[
                    "Fait à Libreville le " + $P{DATE_EMISSION}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="280" y="443" width="200" height="19"/>
                <textFieldExpression><![CDATA[$P{EMETTEUR_FONCTION}]]></textFieldExpression>
            </textField>

            <!-- ================= SIGNATURE ================= -->
            <image>
                <reportElement x="355" y="476" width="80" height="80"/>
                <imageExpression><![CDATA[$P{SIGNATURE}]]></imageExpression>
            </image>

            <textField>
                <reportElement x="282" y="535" width="200" height="19"/>
                <textFieldExpression><![CDATA[$P{EMETTEUR_NOM}]]></textFieldExpression>
            </textField>

        </band>
    </title>

</jasperReport>